# Copy to .env and edit. Never commit the real .env.
# Everything below has a working default for local development; the app runs
# with NO keys at all (mock source + mock market data + canned analyses).

# --- core ------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/trumpmarket
# Single-user auth. This is the token you type on the sign-in screen.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_AUTH_TOKEN=change-me-before-deploying
ENVIRONMENT=development
# Comma-separated, or a JSON array.
CORS_ORIGINS=http://localhost:5173

# --- Anthropic (CHEAPEST CONFIGURATION) ------------------------------------
# Leave ANTHROPIC_API_KEY unset to run with no LLM: events still flow, and the
# signal falls back to the rule-based sentiment scorer (labelled as such).
ANTHROPIC_API_KEY=
#
# Haiku for BOTH triage and analysis. This is the cheapest useful setup: Haiku
# is $1/$5 per million tokens against Opus 5's $5/$25, so the same traffic costs
# roughly a fifth. Change ANTHROPIC_ANALYSIS_MODEL to claude-opus-5 if the
# analyses turn out too shallow -- and watch /data-quality for a week first,
# because at this volume the difference may not be worth 5x.
ANTHROPIC_TRIAGE_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_ANALYSIS_MODEL=claude-haiku-4-5-20251001
#
# NOTE: `effort` is not supported on Haiku 4.5 and is omitted automatically when
# the model does not accept it -- this setting only applies to Opus/Sonnet. It
# is left here so switching the model back up needs no other change.
ANTHROPIC_ANALYSIS_EFFORT=medium
#
# Hard ceiling on model calls per day, so a stuck source cannot run up a bill.
# 150 is deliberately tight: with the rule gate and triage floor below, a normal
# day should not come close. Hitting it is a signal that a gate has stopped
# working, not a reason to raise it.
LLM_DAILY_CALL_BUDGET=150
#
# true => the offline canned scorer, no API calls at all. START HERE: run the
# first week like this. You get polling, dedup, ticker matching and the
# relevance gate under real volume for zero tokens, and you find the broken
# feeds before you are paying per item to process them. Results are stamped
# "canned-mock" everywhere they appear, and switching to false re-analyses
# everything properly -- the analysis cache is keyed on (content, model, mode),
# so canned results are never inherited by the real model.
LLM_FAKE_MODE=true

# --- embeddings (similarity search + novelty) ------------------------------
# hashing               = dependency-free, deterministic, LEXICAL (word overlap,
#                         not meaning). Default: no model download, no torch.
# sentence-transformers = real local semantic model. Requires
#                         `pip install -r backend/requirements-embeddings.txt`
#                         (~2 GB with torch). Anthropic has no embeddings API,
#                         so this genuinely runs on your own machine.
EMBEDDING_PROVIDER=hashing
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Both providers emit this dimension, so switching providers needs a re-embed
# but never a schema migration. 384 = all-MiniLM-L6-v2.
EMBEDDING_DIM=384
# Leave unset so each provider's own threshold applies. Similarity scores are
# NOT comparable across providers: lexical matches top out around 0.4 where a
# transformer would say 0.8. Only set this if you know which provider you mean.
# SIMILARITY_THRESHOLD=
SIMILAR_EVENTS_LIMIT=10
NOVELTY_WINDOW_DAYS=30

# --- event study -----------------------------------------------------------
# Market-model estimation window, in trading days before each event, and the
# gap left before the event so the run-up cannot contaminate alpha/beta.
EVENT_STUDY_ESTIMATION_DAYS=180
EVENT_STUDY_GAP_DAYS=5
EVENT_STUDY_MIN_OBSERVATIONS=60

# --- market data -----------------------------------------------------------
# mock         = deterministic synthetic bars, no network, supports intraday
# stooq        = free, no API key, DAILY BARS ONLY (so only 1d/3d/5d horizons)
# alphavantage = free tier, NEEDS MARKET_DATA_API_KEY, daily bars only
MARKET_DATA_PROVIDER=mock
#
# Tried when the primary raises. Leave empty to disable. Worth setting: Stooq has
# never been verified against the live service from this build environment, and
# one moved endpoint would otherwise leave the app with no prices at all --
# which is every number it computes. `make verify-sources` probes both sides
# separately, so a working fallback cannot hide a broken primary.
MARKET_DATA_FALLBACK_PROVIDER=
#
# Free key from https://www.alphavantage.co/support/#api-key . Stooq needs none.
MARKET_DATA_API_KEY=
BENCHMARK_SYMBOL=SPY
MARKET_CONTEXT_SYMBOLS=SPY,QQQ,VIX,TNX

# --- sources ---------------------------------------------------------------
# Available: mock, whitehouse, federal_register, news_rss, truth_social,
#            congress, oge
# truth_social and oge are manual-import only -- see docs/PHASE0_FEASIBILITY.md.
ENABLED_SOURCES=mock
# Override the feed lists if a government site moves its feeds.
# WHITEHOUSE_FEEDS=https://www.whitehouse.gov/presidential-actions/feed/
# NEWS_RSS_FEEDS=https://example.com/feed1,https://example.com/feed2
NEWS_API_KEY=
# Free key from https://api.congress.gov/sign-up/ . Without it the Congress
# adapter reports NEEDS_KEY and polls nothing -- it never errors.
CONGRESS_API_KEY=
# OGE publishes filings as documents, not as an API. Point this at a JSON index
# you maintain yourself (same shape as the manual import), or leave it blank and
# use the manual import. The adapter never infers undisclosed holdings.
OGE_FEED_URL=

# --- web push --------------------------------------------------------------
# Generate a keypair:  python scripts/generate_vapid_keys.py
# ONLY the public key is ever sent to the browser. Leave these blank and push
# is disabled cleanly -- the in-app notification centre keeps working.
# Note: on iPhone, push is delivered only to a Home-Screen-installed app.
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:you@example.com
WEB_PUSH_TTL_SECONDS=3600
WEB_PUSH_MAX_RETRIES=3
# Consecutive failures after which a subscription is retired.
WEB_PUSH_MAX_FAILURES=5

# --- forward-only evaluation -----------------------------------------------
# The date this deployment started collecting its own data. SET THIS ON THE DAY
# YOU DEPLOY and never change it. Everything before it is backfilled history the
# model may have been trained on and the thresholds were tuned against;
# everything after it, nothing in this system could have known in advance. The
# backtest page's "forward only" filter is disabled until this is set, and a
# forward-only run stays uninformative for months. That is the honest pace.
DEPLOYED_AT=

# --- shadow model comparison -----------------------------------------------
# Optional. When set, a deterministic sample of analysed events is ALSO run on
# this model and stored in `shadow_analyses` -- a table nothing that builds a
# signal, an alert or a backtest reads. Use it to find out whether the cheap
# model is good enough instead of guessing. It is a SECOND BILL: leave unset and
# not one extra call is made.
SHADOW_ANALYSIS_MODEL=
SHADOW_SAMPLE_RATE=0.1

# --- deployment ------------------------------------------------------------
# nginx is the only published service. Local defaults 8080/8443; production
# sets 80/443. See docker-compose.yml for why publishing anything else is a
# hole that ufw cannot close.
HTTP_PORT=8080
HTTPS_PORT=8443
DOMAIN=localhost
# app.conf = HTTP only (local, and while certbot issues the first certificate).
# app-tls.conf = production, after the certificate exists.
NGINX_CONF=app.conf
# Change before deploying: this is the database superuser password.
POSTGRES_PASSWORD=postgres
# Nightly pg_dump. BACKUP_HOUR is UTC.
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=7
BACKUP_HOUR=3

# --- digests ---------------------------------------------------------------
# The daily digest fires at each user's own local digest hour (set per user
# under Settings), not at a fixed UTC hour. Set DIGEST_ENABLED=false to stop
# the worker checking at all.
DIGEST_ENABLED=true
# Opt-in: an additional digest every hour. Off by default -- it is a lot of
# notifications for a single-user tool.
HOURLY_DIGEST_ENABLED=false

# --- email (Phase 3) -------------------------------------------------------
# Email disables itself automatically when SMTP_HOST or EMAIL_FROM is absent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=

# --- signal tuning (shown in the UI under Settings) ------------------------
SIGNAL_WEIGHT_SENTIMENT=0.35
SIGNAL_WEIGHT_HISTORICAL=0.35
SIGNAL_WEIGHT_CONSISTENCY=0.20
SIGNAL_WEIGHT_NOVELTY=0.10
SIGNAL_RETURN_SCALE=0.05
SIGNAL_THRESHOLD_STRONG_BULL=0.6
SIGNAL_THRESHOLD_BULL=0.2
SIGNAL_THRESHOLD_BEAR=-0.2
SIGNAL_THRESHOLD_STRONG_BEAR=-0.6
MIN_USABLE_SAMPLE=10
MIN_RELIABLE_SAMPLE=20
SIGNAL_PRIMARY_HORIZON=1d
# Below MIN_USABLE_SAMPLE the score is sentiment-only (historical, consistency
# AND novelty are all dropped) and capped here, so a reading of one piece of
# text cannot produce a STRONG label. Keep below SIGNAL_THRESHOLD_STRONG_BULL.
SIGNAL_TEXT_ONLY_CAP=0.4
# Unreliable-sample signals never raise a threshold alert, whatever an
# individual alert rule asks for. A rule can raise this bar but not lower it.
ALERTS_REQUIRE_USABLE_SAMPLE=true
# An item scoring below this never escalates to cheap-model triage. Triage is
# for borderline items; paying a model call to confirm that a golf post is
# irrelevant is the cost leak the rule gate exists to plug. 0.0 triages all.
TRIAGE_RELEVANCE_FLOOR=0.15
# Congress moves hundreds of bills a week, so its adapter gates them on
# keywords BEFORE storing anything -- stricter than the pipeline's 0.3.
CONGRESS_RELEVANCE_THRESHOLD=0.5

# --- polling (minutes) -----------------------------------------------------
POLL_INTERVAL_HIGH_MINUTES=2
POLL_INTERVAL_NORMAL_MINUTES=5
POLL_INTERVAL_SLOW_MINUTES=20
PIPELINE_INTERVAL_MINUTES=1
SOURCE_FAILURE_ALERT_THRESHOLD=3
